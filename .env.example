# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.
#
# Find these in: Supabase dashboard → Project Settings → API
# (Supabase now shows this as PUBLISHABLE_KEY — it is the same as the anon key)
#
# SAFE to expose in the browser — all access is enforced by Row Level Security.
# NEVER put the service_role / secret key here — it bypasses all RLS.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
